---
// BIVIO · PROPOSTA D — C mescolata con A.
// L'atmosfera cinematografica della C, ma i due rami sono due blocchi veri
// con la loro fotografia, come nella A. Pagina di prova, noindex.
import '../styles/global.css';
import { Image } from 'astro:assets';
import coast from '../assets/gateway/coast.webp';
import engineering from '../assets/gateway/engineering.webp';
import villa from '../assets/ct/ten-villas-1.webp';
import spa from '../assets/ct/longevity-1.webp';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Proposta D · Tiesse Group</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;1,6..96,400&family=Inter:wght@300;400&display=swap" rel="stylesheet">
	</head>

	<body class="gd">
		<div class="gd-stage">
			<Image class="gd-img gd-1" src={coast} alt="" widths={[1000, 1600, 2000]} sizes="100vw" loading="eager" />
			<Image class="gd-img gd-2" src={engineering} alt="" widths={[800, 1200, 1600]} sizes="100vw" />
			<Image class="gd-img gd-3" src={villa} alt="" widths={[1000, 1600, 2000]} sizes="100vw" />
			<Image class="gd-img gd-4" src={spa} alt="" widths={[1000, 1600, 2000]} sizes="100vw" />
		</div>

		<a class="gd-lang" href="/it">IT</a>

		<header class="gd-head">
			<img class="gd-mark" src="/img/tiesse-group-mark.png" alt="Tiesse Group" />
			<h1>Real estate development,<br/><em>built on engineering.</em></h1>
		</header>

		<main class="gd-doors">
			<a class="gd-door" href="/tiesse-servizi">
				<span class="gd-thumb">
					<Image src={engineering} alt="" widths={[500, 800, 1100]} sizes="(max-width:820px) 100vw, 40vw" />
				</span>
				<span class="gd-txt">
					<span class="gd-kicker">Engineering</span>
					<span class="gd-name">Tiesse Servizi</span>
					<span class="gd-line">Design, structural engineering and construction management. Since 2001.</span>
					<span class="gd-cta">Enter</span>
				</span>
			</a>

			<a class="gd-door" href="/ct-developments">
				<span class="gd-thumb">
					<Image src={villa} alt="" widths={[500, 800, 1100]} sizes="(max-width:820px) 100vw, 40vw" />
				</span>
				<span class="gd-txt">
					<span class="gd-kicker">Development</span>
					<span class="gd-name">C&amp;T Developments</span>
					<span class="gd-line">We find the opportunity, take it through permitting and deliver it.</span>
					<span class="gd-cta">Discover</span>
				</span>
			</a>
		</main>

		<footer class="gd-foot"><span>Bologna</span><i></i><span>Los Angeles</span><i></i><span>Dubai</span></footer>

		<style is:global>
			:root { --g-green: #091A10; --g-gold: #D9C7A3; }
			html, body { height: 100%; }
			body.gd { margin: 0; background: var(--g-green); color: #fff; font-family: 'Inter', sans-serif; font-weight: 300;
				display: flex; flex-direction: column; min-height: 100svh; position: relative; overflow-x: hidden; }

			/* fondo cinematografico */
			.gd-stage { position: fixed; inset: 0; z-index: 0; background: var(--g-green); }
			.gd-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; animation: gd-fade 24s cubic-bezier(.4,0,.2,1) infinite; }
			.gd-1 { animation-delay: 0s; } .gd-2 { animation-delay: 6s; } .gd-3 { animation-delay: 12s; } .gd-4 { animation-delay: 18s; }
			@keyframes gd-fade { 0% { opacity: 0; transform: scale(1.07); } 4% { opacity: 1; } 21% { opacity: 1; } 27% { opacity: 0; } 100% { opacity: 0; transform: scale(1); } }
			.gd-stage::after { content: ""; position: absolute; inset: 0; background:
				radial-gradient(120% 95% at 50% 36%, rgba(9,26,16,.46) 0%, rgba(9,26,16,.88) 68%, rgba(9,26,16,.97) 100%); }

			.gd-lang { padding: 10px 8px; margin: -10px -8px; position: absolute; right: 26px; top: 26px; z-index: 3; font-size: 11px; letter-spacing: .2em; color: rgba(255,255,255,.7); text-decoration: none; }

			/* testata */
			.gd-head { position: relative; z-index: 2; text-align: center; padding: clamp(34px, 5vh, 64px) clamp(20px, 5vw, 60px) 0; }
			.gd-mark { height: 58px; width: auto; margin: 0 auto; box-shadow: 0 0 0 1px rgb(217 199 163 / .35), 0 14px 36px rgb(0 0 0 / .5); animation: gd-up 1.1s cubic-bezier(.2,.6,.2,1) both; }
			.gd-head h1 { margin: 26px 0 0; font-family: 'Bodoni Moda', serif; font-weight: 400; font-size: clamp(26px, 4.2vw, 56px); line-height: 1.08; letter-spacing: -.015em; animation: gd-up 1.1s cubic-bezier(.2,.6,.2,1) .2s both; }
			.gd-head h1 em { font-style: italic; color: var(--g-gold); }

			/* le due porte, studiate come nella A */
			.gd-doors { position: relative; z-index: 2; flex: 1; display: grid; gap: 18px; align-content: center;
				padding: clamp(28px, 5vh, 56px) clamp(20px, 5vw, 60px); max-width: 1240px; margin: 0 auto; width: 100%; box-sizing: border-box; }
			@media (min-width: 880px) { .gd-doors { grid-template-columns: 1fr 1fr; gap: 28px; } }
			.gd-door { display: grid; text-decoration: none; color: #fff; background: rgba(9,26,16,.42);
				border: 1px solid rgba(217,199,163,.22); backdrop-filter: blur(3px);
				transition: border-color .6s, background-color .6s, transform .6s cubic-bezier(.2,.6,.2,1);
				animation: gd-up 1.1s cubic-bezier(.2,.6,.2,1) .45s both; }
			.gd-door:nth-child(2) { animation-delay: .62s; }
			.gd-door:hover { border-color: rgba(217,199,163,.6); background: rgba(9,26,16,.58); transform: translateY(-4px); }
			.gd-thumb { display: block; overflow: hidden; aspect-ratio: 16 / 9; }
			.gd-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.2,.6,.2,1); }
			.gd-door:hover .gd-thumb img { transform: scale(1.05); }
			.gd-txt { display: block; padding: clamp(20px, 2.4vw, 32px); }
			.gd-kicker { display: block; font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: var(--g-gold); margin-bottom: 12px; }
			.gd-name { display: block; font-family: 'Bodoni Moda', serif; font-weight: 400; font-size: clamp(23px, 2.6vw, 34px); line-height: 1.05; }
			.gd-line { display: block; margin-top: 12px; font-size: 14px; line-height: 1.6; color: rgba(255,255,255,.78); max-width: 40ch; }
			.gd-cta { display: inline-block; margin-top: 18px; font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: var(--g-gold); border-bottom: 1px solid rgba(217,199,163,.4); padding-bottom: 5px; transition: border-color .5s; }
			.gd-door:hover .gd-cta { border-color: var(--g-gold); }

			@keyframes gd-up { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

			.gd-foot { position: relative; z-index: 2; display: flex; justify-content: center; gap: 14px; align-items: center; padding: 14px 20px 22px; font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: rgba(255,255,255,.55); }
			.gd-foot i { width: 3px; height: 3px; border-radius: 50%; background: var(--g-gold); }

			@media (prefers-reduced-motion: reduce) {
				.gd-img { animation: none; opacity: 0; } .gd-1 { opacity: 1; }
				.gd-mark, .gd-head h1, .gd-door { animation: none; }
			}
		</style>
	</body>
</html>
