---
// Pagina per un indirizzo che non esiste: prima non c'era e il sito
// rispondeva come se la pagina ci fosse.
import '../styles/global.css';
import '../styles/ct.css';
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="robots" content="noindex" />
		<title>Page not found | Tiesse Group</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;1,6..96,400&family=Inter:wght@300;400&display=swap" rel="stylesheet">
	</head>
	<body class="ct">
		<section class="ct-band" style="min-height:100vh;display:flex;align-items:center">
			<div class="ct-wrap">
				<p class="ct-eyebrow">404</p>
				<h1 class="ct-display" style="max-width:16ch">This page does not <em>exist.</em></h1>
				<div class="ct-hair"></div>
				<p class="ct-lede">The address may have changed, or the page was never here. Pick a way back in.</p>
				<div class="ct-foot-links" style="margin-top:38px">
					<a href="/">Tiesse Group</a>
					<a href="/tiesse-servizi">Tiesse Servizi</a>
					<a href="/ct-developments">C&amp;T Developments</a>
					<a href="/en/projects">Projects</a>
				</div>
			</div>
		</section>
	</body>
</html>
