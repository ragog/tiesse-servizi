---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import ctBanner from '../assets/ct/six-villas-5.webp';

interface Props {
  content: any;
  locale: 'it' | 'en';
}

const { content, locale } = Astro.props;
const projectsUrl = locale === 'it' ? '/progetti' : '/en/projects';
const ctUrl = locale === 'it' ? '/it/ct-developments' : '/ct-developments';
const h = content.home_sections;
---

<BaseLayout content={content} locale={locale}>
	<!-- Hero Section -->
	<section id="home" class="relative h-screen flex items-center overflow-hidden">
		<div class="absolute inset-0 z-0">
			<img src="/img/ChatGPT Image Dec 5, 2025, 12_57_10 PM.png" alt="" class="w-full h-full object-cover" />
			<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/45 to-black/20"></div>
		</div>
		<div class="relative z-10 w-full pl-6 sm:pl-10 md:pl-16 lg:pl-24 pr-4 text-white -mt-8 md:-mt-16">
			<div class="max-w-md md:max-w-lg lg:max-w-xl">
				<p class="text-xs md:text-sm tracking-[0.3em] uppercase text-white/70 mb-6">{content.hero.eyebrow}</p>
				<h1 class="text-5xl md:text-6xl lg:text-7xl font-light leading-[1.05] tracking-tight mb-8 md:mb-10" set:html={content.hero.subtitle}></h1>
				<p class="text-base md:text-lg text-white/80 font-light leading-relaxed mb-5 md:mb-6">{content.hero.body}</p>
				<p class="text-[11px] md:text-xs tracking-[0.2em] uppercase text-white/50 italic mb-8">{content.hero.trust}</p>
				<a href={projectsUrl}
				   class="inline-flex items-center gap-3 py-2 text-xs md:text-sm tracking-[0.25em] uppercase text-white border-b border-white/50 hover:border-white pb-2 transition-colors mb-10">
					<span>{content.hero.cta_text}</span>
					<span aria-hidden="true">→</span>
				</a>
				<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs md:text-sm tracking-widest uppercase text-white/70">
					<span>Est. 2001</span>
					<span class="w-1 h-1 bg-white/50 rounded-full"></span>
					<span>{content.footer.group_line}</span>
				</div>
			</div>
		</div>
		<div class="absolute bottom-8 left-6 sm:left-10 md:left-16 lg:left-24 z-10 flex items-center gap-4 text-xs md:text-sm tracking-widest uppercase text-white/50">
			<span>Bologna (Italy)</span>
			<span class="w-1 h-1 bg-white/30 rounded-full"></span>
			<span>Los Angeles (USA)</span>
		</div>
	</section>

	<!-- KEY STATS STRIP -->
	<section class="bg-white border-b border-gray-200">
		<div class="max-w-7xl mx-auto px-6 sm:px-6 lg:px-8">
			<div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-gray-200">
				{content.key_facts.items.map((item: { value: string; label: string }) => (
					<div class="py-10 px-4 md:px-6 text-center">
						<div class="text-3xl md:text-5xl font-light text-gray-900 mb-2">{item.value}</div>
						<div class="text-[11px] md:text-xs tracking-widest uppercase text-gray-500">{item.label}</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- 01 · ABOUT -->
	<section id={locale === 'it' ? 'chi-siamo' : 'about'} class="py-28 md:py-40 bg-white border-b border-gray-200">
		<div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16">
			<div class="grid md:grid-cols-12 gap-10 md:gap-16 items-start">
				<div class="md:col-span-7">
					<p class="text-[11px] md:text-xs tracking-[0.3em] uppercase text-gray-400 mb-10">01 · {h.about_eyebrow}</p>
					<h2 class="text-3xl md:text-5xl font-light leading-tight tracking-tight text-gray-900">
						{h.about_title}
					</h2>
				</div>
				<div class="md:col-span-5 space-y-5">
					{Array.isArray(h.about_body)
						? h.about_body.map((p: string) => (
							<p class="text-base md:text-lg leading-[1.6] font-light text-gray-700">{p}</p>
						))
						: <p class="text-base md:text-lg leading-[1.6] font-light text-gray-700">{h.about_body}</p>
					}
					{h.about_closing && (
						<p class="text-xs tracking-[0.2em] uppercase text-gray-400">{h.about_closing}</p>
					)}
				</div>
			</div>
		</div>
	</section>

	<!-- 02 · TECHNICAL · PROJECTS -->
	<section id="technical" class="py-28 md:py-40 bg-gray-50 border-b border-gray-200">
		<div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16">
			<div class="grid md:grid-cols-12 gap-10 md:gap-16 items-start">
				<div class="md:col-span-7">
					<p class="text-[11px] md:text-xs tracking-[0.3em] uppercase text-gray-400 mb-10">02 · {h.technical_eyebrow}</p>
					<h2 class="text-3xl md:text-5xl font-light leading-tight tracking-tight text-gray-900">
						{h.technical_title}
					</h2>
				</div>
				<div class="md:col-span-5">
					<p class="text-base md:text-lg leading-[1.6] font-light text-gray-700 mb-10" set:html={h.technical_body}></p>
					<a href={projectsUrl}
					   class="inline-flex items-center gap-3 py-2 text-xs md:text-sm tracking-[0.25em] uppercase text-gray-900 border-b border-gray-900/50 hover:border-gray-900 pb-2 transition-colors">
						<span>{h.technical_cta}</span>
						<span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 03 · TEAM -->
	<section id="founder" class="py-28 md:py-40 bg-white border-b border-gray-200">
		<div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16">

			<!-- Founder -->
			<div class="grid md:grid-cols-12 gap-10 md:gap-16 items-start pb-16 md:pb-20 border-b border-gray-200 mb-16 md:mb-20">
				<div class="md:col-span-4">
					<p class="text-[11px] md:text-xs tracking-[0.3em] uppercase text-gray-400 mb-10">03 · {content.founder.eyebrow}</p>
					<p class="text-3xl md:text-5xl font-light leading-tight tracking-tight text-gray-900 mb-2">{content.founder.name}</p>
					<p class="text-[11px] tracking-[0.2em] uppercase text-gray-500 mb-10">{content.founder.title}</p>
					<a href={content.founder.linkedin} target="_blank" rel="noopener"
					   class="inline-flex items-center gap-3 py-2 text-xs tracking-[0.25em] uppercase text-gray-900 border-b border-gray-900/50 hover:border-gray-900 pb-2 transition-colors">
						<span>{content.founder.linkedin_label}</span>
						<span aria-hidden="true">→</span>
					</a>
				</div>
				<div class="md:col-span-8 space-y-6">
					{content.founder.bio.map((p: string) => (
						<p class="text-base md:text-lg leading-[1.6] font-light text-gray-700">{p}</p>
					))}
				</div>
			</div>

			<!-- Team grid -->
			<div>
				<p class="text-[11px] md:text-xs tracking-[0.3em] uppercase text-gray-400 mb-10">{content.founder.team_eyebrow}</p>
				<div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-gray-200 border border-gray-200">
					{content.founder.team.map((member: { name: string; title: string; linkedin: string }) => (
						<div class="bg-white p-8 md:p-10 flex flex-col">
							<p class="text-base md:text-lg font-light text-gray-900 mb-1">{member.name}</p>
							<p class="text-[11px] tracking-[0.15em] uppercase text-gray-500 mb-6 leading-relaxed flex-1">{member.title}</p>
							{member.linkedin && (
								<a href={member.linkedin} target="_blank" rel="noopener"
								   class="inline-flex items-center gap-2 py-2 text-[11px] tracking-[0.2em] uppercase text-gray-400 hover:text-gray-900 transition-colors border-b border-gray-200 hover:border-gray-900 pb-1 self-start">
									LinkedIn →
								</a>
							)}
						</div>
					))}
				</div>
			</div>

		</div>
	</section>

	<!-- 04 · SELECTED PARTNERS -->
	<section id="partners" class="pt-28 md:pt-40 pb-10 md:pb-12 bg-gray-50 border-b border-gray-200">
		<div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16">
			<div class="grid md:grid-cols-12 gap-10 md:gap-16 items-start mb-16 md:mb-20">
				<div class="md:col-span-7">
					<p class="text-[11px] md:text-xs tracking-[0.3em] uppercase text-gray-400 mb-10">04 · {content.partners.eyebrow}</p>

					<h2 class="text-3xl md:text-5xl font-light leading-tight tracking-tight text-gray-900">
						{content.partners.title}
					</h2>
				</div>
				<div class="md:col-span-5">
					<p class="text-base md:text-lg leading-[1.6] font-light text-gray-700">
						{content.partners.body}
					</p>
				</div>
			</div>
			<!-- Le colonne seguono il numero dei gruppi: con tre gruppi su quattro
			     colonne restava un riquadro grigio vuoto. Niente bordi a tabella,
			     loghi tutti alla stessa altezza. -->
			<div class={`grid gap-10 md:gap-14 sm:grid-cols-2 ${content.partners.groups.length >= 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-2'}`}>
				{content.partners.groups.map((group: { title: string; description: string; logos: { name: string; src?: string; url?: string }[] }, i: number) => (
					<div class="flex flex-col border-t border-gray-300 pt-6">
						<div class="text-[11px] tracking-[0.25em] text-gray-400 mb-5 tabular-nums">{String(i + 1).padStart(2, '0')}</div>
						<h3 class="text-lg md:text-xl font-light text-gray-900 leading-snug mb-3 tracking-tight">{group.title}</h3>
						<p class="text-sm md:text-[15px] text-gray-600 font-light leading-relaxed">{group.description}</p>

						{group.logos.length > 0 && (
							<div class="mt-8 flex flex-wrap items-center gap-x-10 gap-y-6">
								{group.logos.map((logo) => {
									// Senza file del logo scriviamo il nome, alto quanto i loghi.
									const inner = logo.src ? (
										<img src={logo.src} alt={logo.name} loading="lazy"
											class="h-12 md:h-14 w-auto max-w-[13rem] object-contain" />
									) : (
										<span class="h-12 md:h-14 flex items-center text-sm md:text-[15px] font-medium tracking-[0.18em] uppercase text-gray-700 whitespace-nowrap">
											{logo.name}
										</span>
									);
									return logo.url
										? <a href={logo.url} target="_blank" rel="noopener" aria-label={logo.name}>{inner}</a>
										: inner;
								})}
							</div>
						)}
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- NEWS, simplified, borderless cards -->
	<section id="news" class="py-28 md:py-40 bg-white border-b border-gray-200">
		<div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16">
			<div class="grid md:grid-cols-12 gap-10 md:gap-16 items-start mb-16 md:mb-20">
				<div class="md:col-span-7">
					<p class="text-[11px] md:text-xs tracking-[0.3em] uppercase text-gray-400 mb-10">05 · {content.news.eyebrow}</p>
					<h2 class="text-3xl md:text-5xl font-light leading-tight tracking-tight text-gray-900">
						{content.news.title}
					</h2>
				</div>
				<div class="md:col-span-5 md:text-right">
					<a href={content.news.linkedin_url} target="_blank" rel="noopener"
					   class="inline-flex items-center gap-3 py-2 text-xs md:text-sm tracking-[0.25em] uppercase text-gray-900 border-b border-gray-900/50 hover:border-gray-900 pb-2 transition-colors">
						<span>{content.news.linkedin_cta}</span>
						<span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-14 border-t border-gray-200 pt-12 md:pt-16">
				{content.news.items.map((item: { date: string; category: string; title: string; description: string; href: string }) => (
					<div>
						<div class="flex items-center justify-between mb-6">
							<span class="text-xs tracking-widest uppercase text-gray-400 tabular-nums">{item.date}</span>
							<span class="text-[11px] tracking-[0.2em] uppercase text-gray-400">{item.category}</span>
						</div>
						<h3 class="text-xl md:text-2xl font-light text-gray-900 leading-snug tracking-tight mb-4">{item.title}</h3>
						<p class="text-sm text-gray-600 font-light leading-relaxed">{item.description}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- RIMANDO A C&T DEVELOPMENTS, il ramo di sviluppo del gruppo -->
	<section class="relative bg-[#0D2417] overflow-hidden">
		<div class="absolute inset-0">
			<Image
				src={ctBanner}
				alt=""
				class="w-full h-full object-cover opacity-45"
				widths={[900, 1400, 2000]}
				sizes="100vw"
			/>
			<div class="absolute inset-0 bg-gradient-to-r from-[#0D2417] via-[#0D2417]/85 to-[#0D2417]/40"></div>
		</div>
		<div class="relative max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 py-24 md:py-36 text-white">
			<div class="grid md:grid-cols-12 gap-10 md:gap-16 items-end">
				<div class="md:col-span-7">
					<p class="text-[11px] md:text-xs tracking-[0.35em] uppercase text-[var(--color-gold)]/80 mb-8">{h.ct_banner_eyebrow}</p>
					<h2 class="text-3xl md:text-5xl font-light leading-tight tracking-tight">{h.ct_banner_title}</h2>
				</div>
				<div class="md:col-span-5">
					<p class="text-base md:text-lg leading-[1.6] font-light text-white/75 mb-10">{h.ct_banner_body}</p>
					<a href={ctUrl}
					   class="inline-flex items-center gap-3 py-2 text-xs md:text-sm tracking-[0.25em] uppercase text-[var(--color-gold)] border-b border-[var(--color-gold)]/40 hover:border-[var(--color-gold)] pb-2 transition-colors">
						<span>{h.ct_banner_cta}</span>
						<span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- CONTACT, minimal -->
	<section id={locale === 'it' ? 'contatti' : 'contact'} class="py-28 md:py-40 bg-[#1a1a1a] text-white">
		<div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16">
			<div class="grid md:grid-cols-12 gap-10 md:gap-16 items-start">
				<div class="md:col-span-7">
					<p class="text-[11px] md:text-xs tracking-[0.3em] uppercase text-white/40 mb-10">{content.contatti.eyebrow}</p>
					<h2 class="text-3xl md:text-5xl font-light leading-tight tracking-tight">
						{content.contatti.title}
					</h2>
				</div>
				<div class="md:col-span-5">
					<p class="text-base md:text-lg text-white/70 font-light leading-[1.6] mb-10">{content.contatti.subtitle}</p>
					<a href={`mailto:${content.footer.email_value}`}
					   class="inline-flex items-center gap-4 text-base md:text-lg font-light text-white border-b border-white/50 hover:border-white pb-2 transition-colors">
						<span>{content.footer.email_value}</span>
						<span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
