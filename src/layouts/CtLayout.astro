---
// Pagina principale di C&T Developments.
// Corta per scelta: metodo, concept, dove guardiamo, capitale, gruppo.
// Longevity e ogni singolo concept vivono su pagine proprie.
import { Image } from 'astro:assets';
import CtShell from './CtShell.astro';

import heroImg from '../assets/ct/six-villas-2.webp';
import six1 from '../assets/ct/six-villas-1.webp';
import hotel1 from '../assets/ct/hotel-1.webp';
import ten1 from '../assets/ct/ten-villas-1.webp';

import tileSardinia from '../assets/real-estate/sardinia-tile.webp';
import tileAeolian from '../assets/real-estate/eolie/cover.webp';
import tileCorsica from '../assets/real-estate/corsica/cover.jpg';
import tileTuscany from '../assets/real-estate/toscana/cover.jpg';
import tileEmilia from '../assets/real-estate/emilia-romagna/cover.jpg';

type Lang = 'it' | 'en' | 'es';

interface Props {
  content: any;
  locale: Lang;
}

const { content, locale } = Astro.props;
const ct = content.ct;

const bases: Record<Lang, string> = { it: '/it/ct-developments', en: '/ct-developments', es: '/es/ct-developments' };
const base = bases[locale];
const tiesseHref = locale === 'it' ? '/it/tiesse-servizi' : '/tiesse-servizi';
const langUrls = bases;

const covers: Record<string, ImageMetadata> = {
  'six-villas': six1,
  'hotel': hotel1,
  'ten-villas': ten1
};
const concepts = ct.concepts.items.filter((c: { hidden?: boolean }) => !c.hidden);

// I concept si presentano divisi per regione: oggi c'e' solo la Sardegna,
// ma la struttura regge Corsica, Toscana, Eolie ed Emilia senza modifiche.
const grouped = (ct.concepts.region_order as string[])
  .map((r) => ({
    key: r,
    label: ct.concepts.region_labels[r],
    items: concepts.filter((c: any) => c.region === r)
  }))
  .filter((g) => g.items.length > 0);

const areaTiles: (ImageMetadata | null)[] = [tileSardinia, tileCorsica, tileTuscany, tileAeolian, tileEmilia];
---

<CtShell content={content} locale={locale} langUrls={langUrls} ogImage="/og/ct-developments.jpg">

	<!-- APERTURA · la fotografia da sola -->
	<section class="ct-hero">
		<Image src={heroImg} alt="" widths={[1000, 1600, 2200]} sizes="(max-width: 900px) 190vw, 100vw" loading="eager" />
		<p class="ct-hero-cap">{concepts[0].title}<span>/</span>{concepts[0].place}</p>
		<div class="ct-scroll"><span>Scroll</span><i></i></div>
	</section>

	<!-- TITOLO -->
	<section class="ct-title ct-title-offset">
		<div class="ct-wrap">
			<div class="ct-panel">
				<p class="ct-eyebrow" data-reveal>{ct.branch}</p>
				<h1 class="ct-display" data-reveal data-reveal-delay="1" set:html={ct.hero_title_html} />
				<div class="ct-hair" data-reveal data-reveal-delay="2"></div>
				<p class="ct-lede" data-reveal data-reveal-delay="2">{ct.hero_lede}</p>
				<div class="ct-figures" data-reveal data-reveal-delay="3">
					{ct.concepts.counters.map((c: string) => {
						const parts = c.split(' ');
						return (
							<div>
								<b>{parts[0]}</b>
								<span>{parts.slice(1).join(' ')}</span>
							</div>
						);
					})}
				</div>
				<div class="ct-cities" data-reveal data-reveal-delay="3">
					<span>Bologna</span><span class="ct-dot"></span><span>Los Angeles</span><span class="ct-dot"></span><span>Dubai</span>
				</div>
			</div>
		</div>
	</section>

	<!-- MANIFESTO -->
	<section class="ct-manifesto">
		<div class="ct-wrap">
			<p set:html={ct.manifesto_html} />
		</div>
	</section>

	<!-- 01 · METODO -->
	<section id="method" class="ct-band">
		<div class="ct-wrap">
			<p class="ct-num" data-reveal>01</p>
			<h2 class="ct-h2" style="max-width:15ch" data-reveal data-reveal-delay="1">{ct.approach.title}</h2>
			<div class="ct-steps">
				{ct.approach.steps.map((s: { num: string; title: string; body: string }) => (
					<div class="ct-step" data-reveal>
						<span class="ct-step-num">{s.num}</span>
						<h3>{s.title}</h3>
						<p>{s.body}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- 02 · CONCEPT · solo l'indice, ogni scheda ha la sua pagina -->
	<section id="concepts" class="ct-band ct-band-dark">
		<div class="ct-wrap">
			<div class="ct-concepts-head">
				<div data-reveal>
					<p class="ct-num">02</p>
					<h2 class="ct-h2">{ct.concepts.title}</h2>
				</div>
				<div class="ct-body">
					<p>{ct.concepts.intro}</p>
				</div>
			</div>

			<div class="ct-counters">
				{ct.concepts.counters.map((c: string) => (<span>{c}</span>))}
			</div>

			{grouped.map((g) => (
				<div class="ct-region" data-reveal>
					<div class="ct-region-head">
						<h3>{g.label}</h3>
						<span>{g.items.length} {g.items.length === 1 ? ct.concepts.region_count_one : ct.concepts.region_count_many}</span>
					</div>
					<div class="ct-concepts">
						{g.items.map((c: { key: string; title: string; place: string }) => (
							<a class="ct-concept" href={`${base}/concepts/${c.key}`} data-reveal>
								<div class="ct-concept-img">
									<Image src={covers[c.key]} alt={c.title} widths={[600, 900, 1300]} sizes="(max-width:820px) 100vw, 33vw" />
								</div>
								<span class="ct-concept-idx">{String(g.items.indexOf(c) + 1).padStart(2, '0')}</span>
								<h3>{c.title}</h3>
								<p class="ct-place">{c.place}</p>
								<span class="ct-more">{ct.concepts.more}</span>
							</a>
						))}
					</div>
				</div>
			))}

			<a class="ct-link" href={`${base}/concepts`}>{ct.concepts.back}</a>
		</div>
	</section>

	<!-- 03 · DOVE GUARDIAMO -->
	<section id="where" class="ct-band">
		<div class="ct-wrap">
			<div class="ct-two">
				<div>
					<p class="ct-num">03</p>
					<h2 class="ct-h2">{ct.where.title}</h2>
				</div>
				<div class="ct-body">
					{ct.where.blocks.map((b: { title: string; body: string }) => (
						<p><strong>{b.title}.</strong> {b.body}</p>
					))}
				</div>
			</div>

			<div class="ct-tiles" data-reveal>
				{ct.where.tiles.map((label: string, i: number) => (
					<div class="ct-tile">
						{areaTiles[i] && (
							<Image src={areaTiles[i]!} alt={label} widths={[300, 500, 700]} sizes="(max-width:880px) 50vw, 20vw" />
						)}
						<span>{label}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- 04 · CAPITALE -->
	<section id="capital" class="ct-band ct-band-dark">
		<div class="ct-wrap ct-two" data-reveal>
			<div>
				<p class="ct-num">04</p>
				<h2 class="ct-h2">{ct.capital.title}</h2>
			</div>
			<div class="ct-body">
				{ct.capital.body.map((p: string) => (<p>{p}</p>))}
			</div>
		</div>
	</section>

	<!-- 05 · IL GRUPPO E LE PERSONE -->
	<section id="group" class="ct-band ct-rule-top">
		<div class="ct-wrap ct-two" data-reveal>
			<div>
				<p class="ct-num">05</p>
				<h2 class="ct-h2">{ct.group.title}</h2>
			</div>
			<div class="ct-body">
				{ct.group.body.map((p: string) => (<p>{p}</p>))}
				<div class="ct-people">
					{ct.people.items.map((p: { name: string; role: string; place: string }) => (
						<div class="ct-person">
							<strong>{p.name}</strong>
							<span>{p.role}</span>
							<span>{p.place}</span>
						</div>
					))}
				</div>
				<a class="ct-link" href={tiesseHref}>{ct.group.cta}</a>
			</div>
		</div>
	</section>

</CtShell>
