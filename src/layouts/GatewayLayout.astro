---
// Il bivio del gruppo: una sola scena, quattro fotografie che si
// alternano in dissolvenza, e in fondo le due porte dei rami.
import '../styles/global.css';
import { Image } from 'astro:assets';
import coast from '../assets/gateway/coast.webp';
import engineering from '../assets/gateway/engineering.webp';
import villa from '../assets/ct/ten-villas-1.webp';
import spa from '../assets/ct/longevity-1.webp';

interface Props {
  content: any;
  locale: 'it' | 'en';
}

const { content, locale } = Astro.props;
const g = content.gateway;

const leftHref = locale === 'it' ? '/it/tiesse-servizi' : '/tiesse-servizi';
const rightHref = locale === 'it' ? '/it/ct-developments' : '/ct-developments';
const otherLocaleUrl = locale === 'it' ? '/' : '/it';

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const socialImage = new URL('/og/ct-developments.jpg', Astro.site ?? Astro.url.origin).toString();
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;1,6..96,400&family=Inter:wght@300;400&display=swap" rel="stylesheet">
		<title>{g.page_title}</title>
		<meta name="description" content={g.page_description} />

		<!-- Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-GFJ9MYKT92"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-GFJ9MYKT92');
		</script>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Tiesse Group" />
		<meta property="og:locale" content={locale === 'it' ? 'it_IT' : 'en_US'} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={g.page_title} />
		<meta property="og:description" content={g.page_description} />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={g.page_title} />
		<meta name="twitter:description" content={g.page_description} />
		<meta name="twitter:image" content={socialImage} />
	</head>

	<body class="gw">
		<div class="gw-bg">
			<Image class="gw-img gw-1" src={coast} alt="" widths={[1000, 1600, 2000]} sizes="(max-width: 900px) 190vw, 100vw" loading="eager" />
			<Image class="gw-img gw-2" src={engineering} alt="" widths={[800, 1200, 1600]} sizes="(max-width: 900px) 190vw, 100vw" />
			<Image class="gw-img gw-3" src={villa} alt="" widths={[1000, 1600, 2000]} sizes="(max-width: 900px) 190vw, 100vw" />
			<Image class="gw-img gw-4" src={spa} alt="" widths={[1000, 1600, 2000]} sizes="(max-width: 900px) 190vw, 100vw" />
		</div>

		<header class="gw-top">
			<img src="/img/tiesse-group-mark.png" alt="Tiesse Group" />
			<a class="gw-lang" href={otherLocaleUrl}>{g.lang_label}</a>
		</header>

		<main class="gw-mid">
			<p class="gw-kicker">{g.eyebrow}</p>
			<h1 set:html={g.title_html}></h1>
			<p class="gw-lede">{g.lede}</p>
		</main>

		<nav class="gw-doors">
			<a href={leftHref}>
				<span class="gw-door-name">Tiesse Servizi</span>
				<span class="gw-door-line">{g.left_door}</span>
				<span class="gw-arrow" aria-hidden="true">&#8594;</span>
			</a>
			<a href={rightHref}>
				<span class="gw-door-name">C&amp;T Developments</span>
				<span class="gw-door-line">{g.right_door}</span>
				<span class="gw-arrow" aria-hidden="true">&#8594;</span>
			</a>
		</nav>

		<footer class="gw-foot">{g.cities}</footer>

		<style is:global>
			:root { --g-green: #0D2417; --g-gold: #D9C7A3; }
			html, body { height: 100%; }
			body.gw { margin: 0; background: var(--g-green); color: #fff; font-family: 'Inter', sans-serif; font-weight: 300;
				display: flex; flex-direction: column; min-height: 100svh; position: relative; }

			/* le quattro fotografie, sei secondi ciascuna */
			.gw-bg { position: fixed; inset: 0; z-index: 0; }
			.gw-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0;
				animation: gw-fade 24s cubic-bezier(.4,0,.2,1) infinite; }
			.gw-1 { animation-delay: 0s; } .gw-2 { animation-delay: 6s; } .gw-3 { animation-delay: 12s; } .gw-4 { animation-delay: 18s; }
			@keyframes gw-fade { 0% { opacity: 0; transform: scale(1.07); } 4% { opacity: 1; } 21% { opacity: 1; } 27% { opacity: 0; } 100% { opacity: 0; transform: scale(1); } }
			.gw-bg::after { content: ""; position: absolute; inset: 0; background:
				linear-gradient(180deg, rgba(13,36,23,.72) 0%, rgba(13,36,23,.42) 34%, rgba(13,36,23,.86) 100%); }

			.gw-top { position: relative; z-index: 2; display: flex; justify-content: center; padding: 26px 20px 0; }
			.gw-top img { height: 58px; width: auto; margin: 0 auto; box-shadow: 0 0 0 1px rgb(217 199 163 / .35), 0 12px 30px rgb(0 0 0 / .45); }
			.gw-lang { position: absolute; right: 16px; top: 18px; padding: 10px 10px; font-size: 12px; letter-spacing: .2em; color: rgba(255,255,255,.75); text-decoration: none; }
			.gw-lang:hover { color: #fff; }

			.gw-mid { position: relative; z-index: 2; flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 40px clamp(20px, 5vw, 60px); }
			.gw-kicker { margin: 0 0 18px; font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: var(--g-gold); }
			.gw-mid h1 { margin: 0; font-family: 'Bodoni Moda', serif; font-weight: 400; font-size: clamp(30px, 5.4vw, 72px); line-height: 1.08; letter-spacing: -.015em; }
			.gw-mid h1 em { font-style: italic; color: var(--g-gold); }
			.gw-lede { margin: 26px 0 0; max-width: 46ch; font-size: clamp(14.5px, 1.2vw, 17px); line-height: 1.6; color: rgba(255,255,255,.86); }

			.gw-doors { position: relative; z-index: 2; display: grid; border-top: 1px solid rgba(217,199,163,.28); }
			@media (min-width: 860px) { .gw-doors { grid-template-columns: 1fr 1fr; } }
			.gw-doors a { position: relative; display: block; padding: clamp(22px, 2.6vw, 34px) clamp(54px, 5vw, 60px) clamp(22px, 2.6vw, 34px) clamp(20px, 5vw, 60px); text-decoration: none; color: #fff; transition: background-color .5s; }
			.gw-doors a + a { border-top: 1px solid rgba(217,199,163,.28); }
			@media (min-width: 860px) { .gw-doors a + a { border-top: 0; border-left: 1px solid rgba(217,199,163,.28); } }
			.gw-doors a:hover { background: rgba(13,36,23,.72); }
			.gw-door-name { display: block; font-family: 'Bodoni Moda', serif; font-weight: 400; font-size: clamp(22px, 2.2vw, 30px); }
			.gw-door-line { display: block; margin-top: 8px; font-size: 14px; line-height: 1.55; color: rgba(255,255,255,.78); max-width: 42ch; }
			.gw-arrow { position: absolute; right: clamp(20px, 5vw, 60px); top: 50%; transform: translateY(-50%); color: var(--g-gold); font-size: 20px; transition: transform .5s; }
			.gw-doors a:hover .gw-arrow { transform: translateY(-50%) translateX(6px); }

			.gw-foot { position: relative; z-index: 2; text-align: center; padding: 16px 20px 20px; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: rgba(255,255,255,.62); }

			@media (prefers-reduced-motion: reduce) { .gw-img { animation: none; opacity: 0; } .gw-1 { opacity: 1; } }
		</style>
	</body>
</html>
