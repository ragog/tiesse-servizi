---
import '../styles/global.css';

interface Props {
  content: any;
  locale: 'it' | 'en';
}

const { content, locale } = Astro.props;
const g = content.gateway;

const leftHref = locale === 'it' ? '/it/tiesse-servizi' : '/tiesse-servizi';
const rightHref = locale === 'it' ? '/it/ct-developments' : '/ct-developments';
const otherLocaleUrl = locale === 'it' ? '/' : '/it';

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const socialImage = new URL('/img/tiesse-group-logo.jpeg', Astro.site ?? Astro.url.origin).toString();
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
		<title>{g.page_title}</title>
		<meta name="description" content={g.page_description} />

		<!-- Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-GFJ9MYKT92"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-GFJ9MYKT92');
		</script>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Tiesse Group" />
		<meta property="og:locale" content={locale === 'it' ? 'it_IT' : 'en_US'} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={g.page_title} />
		<meta property="og:description" content={g.page_description} />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={g.page_title} />
		<meta name="twitter:description" content={g.page_description} />
		<meta name="twitter:image" content={socialImage} />
	</head>

	<body class="overflow-x-hidden">
		<main class="gateway">

			<!-- Testata: fascia in cima sul telefono, sovrimpressione da tablet in su -->
			<header class="gw-header">
				<!-- Blocco unico e compatto: marchio, filo d'oro, riga di descrizione.
				     Niente occhiello "TIESSE GROUP" sopra la tagline: il nome sta già
				     dentro il marchio, ripeterlo era quello che sfilacciava la zona.
				     Il filo d'oro è lo stesso stacco che ha il marchio C&T: li imparenta. -->
				<img src="/img/tiesse-group-mark.png" alt="Tiesse Group" class="gw-mark" />
				<span class="gw-rule" aria-hidden="true"></span>
				<p class="gw-tagline">{g.tagline}</p>
			</header>

			<!-- Selettore lingua -->
			<a href={otherLocaleUrl} class="gw-lang">{g.lang_label}</a>

			<div class="gw-split">

			<!-- LEFT / TOP — Tiesse Servizi -->
			<a href={leftHref} class="gw-side gw-left group bg-[#004719]">
				<div class="gw-inner">
					<!-- Nessun marchio: quello del gruppo sta in alto, uno solo per tutta la pagina.
					     Da tablet in su lo spazio resta riservato per tenere i due lati allineati;
					     sul telefono i due blocchi sono impilati e non serve, quindi si toglie. -->
					<div class="hidden md:block md:h-20 md:w-20 md:mb-9" aria-hidden="true"></div>
					<div class="gw-head text-3xl md:text-4xl lg:text-5xl">
						<div class="font-bold tracking-tight leading-none">
							<span class="text-white">{g.left.name_strong}</span><span class="text-[#8BC34A]">{g.left.name_accent}</span>
						</div>
						<p class="mt-3 text-[10px] md:text-xs tracking-[0.25em] uppercase text-white/50">{g.left.sub}</p>
					</div>
					<p class="mt-4 md:mt-5 text-sm md:text-base font-light text-white/70">{g.left.line}</p>
					<p class="mt-2 text-[10px] md:text-xs tracking-[0.25em] uppercase text-white/40">{g.left.meta}</p>
					<span class="gw-cta text-[10px] md:text-xs tracking-[0.25em] uppercase text-[#8BC34A]">{g.left.cta}</span>
				</div>
			</a>

			<!-- RIGHT / BOTTOM — C&T Developments.
			     NON cliccabile finché la pagina non è finita: è un <div>, non un <a>. -->
			<div class="gw-side gw-right bg-[#0D2417] overflow-hidden">
				<div class="gw-inner">
					<!-- Marchio C&T scontornato su trasparenza: monogramma, nome e filo
					     d'oro. La riga di descrizione NON è dentro l'immagine, altrimenti
					     rimpicciolirebbe con lei e diventerebbe illeggibile: è testo vero,
					     alla stessa misura della riga sotto il marchio Tiesse Group. -->
					<img src="/img/ct-developments-logo.png" alt={g.right.alt}
					     class="gw-lockup w-full max-w-[13.5rem] sm:max-w-[17rem] md:max-w-[22rem] h-auto" />
					<p class="gw-tagline gw-tagline-ct">{g.right.tagline}</p>
					<p class="mt-4 md:mt-8 text-[10px] md:text-xs tracking-[0.25em] uppercase text-white/40">{g.right.meta}</p>
					<!-- Occupa lo spazio del richiamo che il lato sinistro ha e questo no,
					     così i due blocchi affiancati restano centrati alla stessa altezza.
					     Sul telefono sono impilati: non serve, e ruberebbe spazio. -->
					<span class="gw-cta hidden md:inline-block invisible md:text-xs" aria-hidden="true">·</span>
				</div>
			</div>

			<!-- Città -->
			<footer class="gw-cities">
				<p class="text-[10px] md:text-xs tracking-[0.25em] uppercase text-white/40">{g.cities}</p>
			</footer>

			</div><!-- /gw-split -->
		</main>

		<style>
			/* ── Impianto ─────────────────────────────────────────────────
			   Telefono: la testata è una fascia in cima, in flusso normale, e il
			   bivio si spartisce l'altezza che avanza. Così le scritte non possono
			   finire sotto la testata, qualunque sia l'altezza dello schermo.
			   Da tablet in su la testata torna in sovrimpressione sui due lati. */

			.gateway {
				position: relative;
				display: flex;
				flex-direction: column;
				min-height: 100vh;
				background: #0D2417;
			}

			.gw-header {
				position: relative;
				z-index: 20;
				flex: 0 0 auto;
				text-align: center;
				padding: 1.6rem 1.5rem 1.4rem;
				background: #004719;   /* uguale al lato Tiesse Servizi: la fascia si fonde col blocco sotto */
			}

			/* Il marchio tiene il suo fondo verde ed è una targa vera: bordo d'oro
			   sottile e ombra staccata. Così, anche a cavallo della diagonale, si
			   legge come appoggiato sopra e non come una toppa mal ritagliata. */
			.gw-mark {
				display: block;
				width: 4.5rem;
				height: 4.5rem;
				margin: 0 auto;
				object-fit: cover;
				border-radius: 3px;
				box-shadow: 0 0 0 1px rgb(217 199 163 / 0.38), 0 12px 30px rgb(0 0 0 / 0.45);
			}

			.gw-rule {
				display: block;
				width: 3.25rem;
				height: 1px;
				margin: 0.95rem auto 0.8rem;
				background: linear-gradient(to right, transparent, rgb(217 199 163 / 0.8), transparent);
			}

			.gw-tagline {
				margin: 0 auto;
				max-width: 24rem;
				font-size: 10px;
				line-height: 1.5;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: rgb(255 255 255 / 0.7);
				/* se proprio deve andare a capo, che spezzi in due righe pari
				   invece di lasciare una parola sola in fondo */
				text-wrap: balance;
			}

			.gw-lang {
				position: absolute;
				top: 1.5rem;
				right: 1.5rem;
				z-index: 30;
				font-size: 11px;
				font-weight: 600;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: rgb(255 255 255 / 0.6);
				text-decoration: none;
				transition: color 0.3s ease;
			}
			.gw-lang:hover { color: #fff; }

			.gw-split {
				position: relative;
				flex: 1 1 auto;
				/* Sotto questa soglia i due blocchi si toccherebbero: meglio far
				   scorrere di poco la pagina che accavallare le scritte. */
				min-height: 36rem;
			}

			.gw-side {
				position: absolute;
				inset: 0;
				text-decoration: none;
				transition: filter 0.35s ease;
			}
			/* Solo il lato cliccabile si illumina al passaggio del mouse */
			a.gw-side:hover { filter: brightness(1.14); }

			.gw-inner {
				position: absolute;
				left: 0;
				right: 0;
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				padding: 0 1.25rem;
				/* min() e non 26rem secco: su un telefono da 390px un blocco
				   da 416px sborderebbe a destra. */
				max-width: min(26rem, 100%);
				margin: 0 auto;
			}

			.gw-cities {
				position: absolute;
				bottom: 0;
				left: 0;
				right: 0;
				z-index: 20;
				pointer-events: none;
				padding: 0 1.5rem 1.75rem;
				text-align: center;
			}

			/* La riga di descrizione del marchio C&T, gemella di quella sotto il
			   marchio Tiesse Group ma in oro. Sta subito sotto il filo dorato con
			   cui finisce l'immagine del marchio. */
			.gw-tagline-ct {
				margin-top: 0.85rem;
				color: rgb(217 199 163 / 0.85);
				max-width: 20rem;
			}

			.gw-cta {
				margin-top: 1.75rem;
				padding-bottom: 0.4rem;
				border-bottom: 1px solid currentColor;
				opacity: 0.55;
				transition: opacity 0.3s ease;
			}
			.gw-side:hover .gw-cta { opacity: 1; }

			/* Telefono: taglio diagonale orizzontale, i due blocchi impilati.
			   Ognuno è centrato in un quarto dell'area del bivio, quindi resta
			   nella propria metà senza toccare né la diagonale né le città. */
			.gw-left  { clip-path: polygon(0 0, 100% 0, 100% 46%, 0 54%); }
			.gw-right { clip-path: polygon(0 54%, 100% 46%, 100% 100%, 0 100%); }
			.gw-left  .gw-inner { top: 23%; transform: translateY(-50%); }
			.gw-right .gw-inner { top: 74%; transform: translateY(-50%); }

			/* Schermi molto piccoli (iPhone SE e simili): scala ridotta, così i due
			   blocchi stanno nelle loro metà senza allungare la pagina per tutti. */
			@media (max-width: 380px) {
				.gw-header { padding-top: 1.25rem; padding-bottom: 1rem; }
				.gw-head { font-size: 1.5rem; }
				.gw-lockup { max-width: 10.75rem; }
				.gw-tagline-ct { margin-top: 0.55rem; }
				.gw-cta { margin-top: 1.25rem; }
			}

			/* Da tablet in su: testata in sovrimpressione e taglio verticale */
			@media (min-width: 768px) {
				.gw-header {
					position: absolute;
					top: 0;
					left: 0;
					right: 0;
					background: transparent;
					pointer-events: none;
					padding: 2.25rem 1.5rem 0;
				}
				.gw-lang { top: 2rem; right: 2rem; font-size: 12px; }
				.gw-mark { width: 5.25rem; height: 5.25rem; }
				.gw-rule { width: 4rem; margin: 1.1rem auto 0.9rem; }
				/* Il blocco si allarga: la riga di descrizione C&T è lunga e dentro
				   26rem si spezzava lasciando "INVESTMENT" orfano sulla seconda riga. */
				.gw-inner { max-width: min(32rem, 100%); }
				.gw-tagline { font-size: 11px; max-width: 32rem; }
				.gw-split { min-height: 100vh; }
				.gw-cities { padding-bottom: 2.25rem; }

				.gw-left  { clip-path: polygon(0 0, 52% 0, 44% 100%, 0 100%); }
				.gw-right { clip-path: polygon(52% 0, 100% 0, 100% 100%, 44% 100%); }
				.gw-left  .gw-inner { top: 50%; left: 0; right: 54%; transform: translateY(-50%); }
				.gw-right .gw-inner { top: 50%; left: 54%; right: 0; transform: translateY(-50%); }
			}
		</style>
	</body>
</html>
