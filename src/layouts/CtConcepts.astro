---
// Indice dei concept: si apre dalla barra e si dirama per regione.
import { Image } from 'astro:assets';
import CtShell from './CtShell.astro';
import heroImg from '../assets/ct/six-villas-5.webp';
import six1 from '../assets/ct/six-villas-1.webp';
import hotel1 from '../assets/ct/hotel-1.webp';
import ten1 from '../assets/ct/ten-villas-1.webp';

type Lang = 'it' | 'en' | 'es';

interface Props {
  content: any;
  locale: Lang;
}
const { content, locale } = Astro.props;
const ct = content.ct;

const bases: Record<Lang, string> = { it: '/it/ct-developments', en: '/ct-developments', es: '/es/ct-developments' };
const base = bases[locale];
const langUrls = { it: bases.it + '/concepts', en: bases.en + '/concepts', es: bases.es + '/concepts' };

const covers: Record<string, ImageMetadata> = { 'six-villas': six1, 'hotel': hotel1, 'ten-villas': ten1 };
const visible = ct.concepts.items.filter((c: any) => !c.hidden);
const grouped = (ct.concepts.region_order as string[])
  .map((r) => ({ key: r, label: ct.concepts.region_labels[r], items: visible.filter((c: any) => c.region === r) }))
  .filter((g) => g.items.length > 0);
---

<CtShell content={content} locale={locale} langUrls={langUrls}
         title={`${ct.concepts.title} | C&T Developments`} description={ct.concepts.intro}
         ogImage="/og/ct-developments.jpg" current="concepts">

	<section class="ct-hero ct-hero-short">
		<Image src={heroImg} alt="" widths={[1000, 1600, 2200]} sizes="100vw" loading="eager" />
		<p class="ct-hero-cap">{ct.concepts.eyebrow}<span>/</span>{ct.concepts.title}</p>
	</section>

	<section class="ct-title">
		<div class="ct-wrap">
			<a class="ct-back" data-reveal href={base}>&#8592; {ct.name_strong}{ct.name_accent}</a>
			<h1 class="ct-display" data-reveal data-reveal-delay="1">{ct.concepts.title}</h1>
			<div class="ct-hair" data-reveal data-reveal-delay="2"></div>
			<p class="ct-lede" data-reveal data-reveal-delay="2">{ct.concepts.intro}</p>
			<div class="ct-cities" data-reveal data-reveal-delay="3">
				{ct.concepts.counters.map((c: string, i: number) => (
					<>
						{i > 0 && <span class="ct-dot"></span>}
						<span>{c}</span>
					</>
				))}
			</div>
		</div>
	</section>

	<section class="ct-band ct-band-dark">
		<div class="ct-wrap">
			{grouped.map((g) => (
				<div class="ct-region" data-reveal>
					<div class="ct-region-head">
						<h2>{g.label}</h2>
						<span>{g.items.length} {g.items.length === 1 ? ct.concepts.region_count_one : ct.concepts.region_count_many}</span>
					</div>
					<div class="ct-concepts">
						{g.items.map((c: { key: string; title: string; place: string; lede?: string; body: string }) => (
							<a class="ct-concept" data-reveal href={`${base}/concepts/${c.key}`}>
								<div class="ct-concept-img">
									<Image src={covers[c.key]} alt={c.title} widths={[600, 900, 1300]} sizes="(max-width:820px) 100vw, 33vw" />
								</div>
								<h3>{c.title}</h3>
								<p class="ct-place">{c.place}</p>
								<p class="ct-concept-line">{c.lede ?? c.body}</p>
								<span class="ct-more">{ct.concepts.more}</span>
							</a>
						))}
					</div>
				</div>
			))}
		</div>
	</section>

</CtShell>
